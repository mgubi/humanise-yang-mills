    <item><verbatim|Lean/YM/AnalyticBridge/LOCAL_GAUSSIAN_LAWS/Enrolled.lean>

    <item><verbatim|Lean/YM/AnalyticBridge/LOCAL_GAUSSIAN_LAWS/Metering.lean>

    <item><verbatim|Lean/YM/AnalyticBridge/LOCAL_GAUSSIAN_LAWS/TellerFold.lean>

    <item><verbatim|Lean/YM/Push/FREE_RESOLVENT/Fold.lean>

    <item><verbatim|Lean/YM/Push/FREE_RESOLVENT/Metric.lean>

    <item><verbatim|Lean/YM/Push/FREE_RESOLVENT/Flat.lean>

    <item><verbatim|Lean/YM/Pressure/Seeds.lean>

    <item><verbatim|Lean/YM/PhysicalNext/AFTERNOON_INTERACTING_RANK_COMPARISON/Leading.lean>

    <item><verbatim|Lean/YM/PhysicalNext/WEIGHTED_GAUSSIAN_MARGINAL_LIMIT_45C/Issue/Cut/Cells.lean>

    <item><verbatim|Lean/YM/PhysicalNext/WEIGHTED_GAUSSIAN_MARGINAL_LIMIT_45C/Issue/Cut/Scissors.lean>

    <item><verbatim|Lean/YM/Extra/ITERATION_NO_LOSS/Columns.lean>

    <item><verbatim|Lean/YM/Extra/ITERATION_NO_LOSS/Inherited.lean>

    <item><verbatim|Lean/YM/PhysicalNext/AFTERNOON_INTERACTING_RANK_COMPARISON/Epoch.lean>

    <item>Parent canonical units read for reuse:
    <verbatim|/private/tmp/ym-existence-20261111/manuscript/existence/actual-reader-tree-covariance.tex>
    (<verbatim|sec:actual-reader-tree-covariance>) and
    <verbatim|/private/tmp/ym-existence-20261111/manuscript/existence/free-horizon-convergence.tex>
